{
  "name": "chess-cinema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-engine.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-engine.mjs",
    "build": "tsc -b && vite build",
    "build:artifact": "npm run build && node scripts/build-artifact.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "chess.js": "^1.0.0",
    "stockfish": "18.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
